{
  "name": "vibe-engineering-framework",
  "version": "0.3.0",
  "description": "Git-native durable project memory and integrity for AI-assisted engineering.",
  "type": "module",
  "bin": {
    "vef": "bin/vef.mjs"
  },
  "exports": {
    "./schema": "./src/lib/schemas.mjs",
    "./transactions": "./src/lib/transactions.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "verify": "npm test && node bin/vef.mjs check",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:check": "npm run verify && npm run release:smoke && npm pack --dry-run --ignore-scripts",
    "prepublishOnly": "npm run release:check"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "keywords": [
    "ai",
    "ai-assisted-engineering",
    "agents",
    "documentation",
    "framework",
    "git",
    "knowledge-graph",
    "project-memory",
    "product-engineering",
    "claude",
    "frontmatter",
    "okf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drmoyassine/vibe-engineering-framework.git"
  },
  "homepage": "https://github.com/drmoyassine/vibe-engineering-framework#readme",
  "bugs": {
    "url": "https://github.com/drmoyassine/vibe-engineering-framework/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "drmoyassine",
  "license": "MIT"
}
